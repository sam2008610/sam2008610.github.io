---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = getTags(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { name: tag.name, posts: tag.posts } }));
}

interface Props {
  name: string;
  posts: Post[];
}
const { name, posts } = Astro.props;
---
<BaseLayout title={`#${name}`} description={`Posts tagged “${name}”`}>
  <div class="container narrow">
    <header class="page-header">
      <p class="muted"><a href="/tags/">Tags</a></p>
      <h1>#{name}</h1>
      <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
