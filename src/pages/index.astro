---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { PROFILE } from '../data/profile';
import { excerpt, formatDate, getPosts } from '../lib/posts';
import hero from '../assets/hero.jpg';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const stats = posts.length > 0
  ? [...PROFILE.stats, { value: posts.length, suffix: '', label: 'Posts written' }]
  : PROFILE.stats;
---
<BaseLayout>
  <!-- Intro -->
  <section class="intro container">
    <div class="intro-text">
      <p class="eyebrow reveal">{PROFILE.role} · {PROFILE.location}</p>
      <h1 class="headline">
        {PROFILE.headline.map((line, i) => (
          <span class="reveal" style={`--delay: ${120 + i * 120}ms`}>{line}</span>
        ))}
      </h1>
      <p class="lead reveal" style="--delay: 360ms">{PROFILE.intro}</p>
      <div class="actions reveal" style="--delay: 480ms">
        <a class="button primary" href="#work">See my work <Icon name="arrow-right" size={16} /></a>
        <a class="button" href="#contact">Get in touch</a>
      </div>
    </div>

    <figure class="now-card reveal" style="--delay: 300ms">
      <Image src={hero} alt="" widths={[480, 960]} sizes="(max-width: 860px) 100vw, 420px" loading="eager" fetchpriority="high" />
      <figcaption>
        <span class="now-label"><span class="pulse" aria-hidden="true"></span>{PROFILE.now.label}</span>
        <span>{PROFILE.now.text}</span>
      </figcaption>
    </figure>
  </section>

  <!-- Stats -->
  <section class="container">
    <dl class="stats" style={`--cols: ${stats.length}`}>
      {stats.map((stat) => (
        <div class="stat reveal">
          <dt>{stat.label}</dt>
          <dd><span class="count" data-to={stat.value}>{stat.value}</span>{stat.suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Work -->
  <section id="work" class="container block">
    <header class="block-header reveal">
      <p class="eyebrow">Selected work</p>
      <h2>Things I've built</h2>
    </header>
    <div class="projects">
      {PROFILE.projects.map((project, i) => (
        <article class="project reveal" style={`--delay: ${i * 90}ms`}>
          <p class="project-index">{String(i + 1).padStart(2, '0')}</p>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <ul class="chips">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          {project.href && (
            <a class="project-link" href={project.href}>{project.linkLabel ?? 'View'} <Icon name="arrow-right" size={14} /></a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="container block">
    <header class="block-header reveal">
      <p class="eyebrow">Experience</p>
      <h2>Where I've worked</h2>
    </header>
    <ol class="timeline">
      {PROFILE.experience.map((item) => (
        <li class="reveal">
          <p class="period">{item.period}</p>
          <div>
            <h3>{item.org}<span class="muted"> · {item.role}</span></h3>
            <p>{item.summary}</p>
            {item.highlights.length > 0 && (
              <ul class="highlights">
                {item.highlights.map((point) => <li>{point}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Writing -->
  {latest.length > 0 && (
    <section id="writing" class="container block">
      <header class="block-header reveal">
        <p class="eyebrow">Writing</p>
        <h2>Recent writing</h2>
        <a class="more" href="/posts/">All posts <Icon name="arrow-right" size={14} /></a>
      </header>
      <div class="writing">
        {latest.map((post) => (
          <a class="writing-item reveal" href={`/posts/${post.id}/`}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h3>{post.data.title}</h3>
            <p>{excerpt(post, 60)}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact" class="container block">
    <div class="contact reveal">
      <p class="eyebrow">Contact</p>
      <h2>Let's talk.</h2>
      <p>Open to roles and collaborations in embedded systems, automotive software and RTOS — or just a chat about low-level code. I read every message.</p>
      <div class="actions">
        <a class="button primary" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      </div>
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 數字從 0 跳到目標值
  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.to);
    if (reduceMotion || !Number.isFinite(target)) return;
    const start = performance.now();
    const duration = 1200;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // 捲到畫面內才淡入
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        entry.target.querySelectorAll<HTMLElement>('.count').forEach(countUp);
        observer.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
