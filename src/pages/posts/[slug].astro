---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import Icon from '../../components/Icon.astro';
import { excerpt, formatDate, getPosts, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // 列表是新到舊：前一篇（較舊）在 i + 1，下一篇（較新）在 i - 1
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { title, date, updated, tags, cover, coverAlt, draft } = post.data;
const { Content } = await render(post);
---
<BaseLayout title={title} description={excerpt(post, 140)} image={cover} type="article" publishedTime={date}>
  <article class="container narrow post">
    <header class="post-header">
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} min read</span>
        {updated && <span>(updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>)</span>}
        {draft && <span class="badge">Draft</span>}
      </p>
      <h1>{title}</h1>
      <TagList tags={tags} />
    </header>

    {cover && (
      <Image
        class="post-cover"
        src={cover}
        alt={coverAlt ?? ''}
        widths={[720, 1440]}
        sizes="(max-width: 760px) 100vw, 720px"
        loading="eager"
      />
    )}

    <div class="prose">
      <Content />
    </div>

    {(older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older ? (
          <a class="prev" href={`/posts/${older.id}/`}>
            <span class="muted"><Icon name="arrow-left" size={14} /> Previous</span>
            <span>{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a class="next" href={`/posts/${newer.id}/`}>
            <span class="muted">Next <Icon name="arrow-right" size={14} /></span>
            <span>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
